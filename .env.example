MATRIX_BASE_URL=https://your.homeserver
MATRIX_USER_ID=@your-bot:your.homeserver
MATRIX_PASSWORD=your-bot-password
MATRIX_DEVICE_NAME=matrix-bot-roll
MATRIX_STORE_PATH=./dev/store

# See README (Architecture) for details on session modes.
# fresh (default): logs in fresh on every start, logs out on shutdown.
# persistent: reuses the same login/device across restarts; requires
# MATRIX_SESSION_MODE=persistent
# MATRIX_SESSION_ENCRYPTION_KEY (generate with `poetry run invoke generate-session-key`).

# Optional overrides (defaults shown):
# MAX_DICE_COUNT=100
# MAX_DICE_SIDES=100
# MAX_DICE_EXPRESSIONS=3
# MAX_TRACKED_ROOMS=1000
# MAX_SAVED_PATTERNS_PER_USER=25
# MAX_PATTERN_NAME_LENGTH=32
# LOG_LEVEL=INFO
# EXTERNAL_LOG_LEVEL=WARNING
# ENABLE_HEALTH_CHECK=false
# PORT=8080
